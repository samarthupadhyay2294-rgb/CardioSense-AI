# backend/.env.example

# Model Paths
SIGNAL_MODEL_PATH=./models/ptbxl_cnn_best.pt
IMAGE_MODEL_PATH=./models/image/best_model.pt
IMAGE_MODEL_CONFIG=./models/image/model_config.json

# Model Configuration
ENABLE_IMAGE_MODEL=true
MODEL_VERSION=1.0

# Database
DATABASE_URL=sqlite:///./cardiosense.db

# API Configuration
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=20

# Batch Processing Configuration
BATCH_MAX_WORKERS=2
BATCH_MAX_FILES=50

# Real-Time Configuration
WEBSOCKET_RATE=100

# Dataset Configuration (for model evaluation)
DATASET_PATH=./ptbxl_database.csv
RECORDS_DIR=./records100

# Environment
ENVIRONMENT=development